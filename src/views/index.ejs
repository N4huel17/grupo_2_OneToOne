        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
        <style>
            
            .custom-chat-container {
                position: fixed;
                bottom: 40px;
                right: 40px;
                z-index: 1000;
                font-size: 32px;
                color: rgb(2, 188, 255);
            }
            
            .custom-chat-modal {
                display: none;
                position: fixed;
                z-index: 999;
                bottom: 20px;
                right: 20px;
                background-color: rgb(185, 184, 184);
                border-radius: 15px;
                box-shadow: 0 4px 8px  rgb(2, 188, 255);
                max-width: 350px;
                width: 100%;
                border-top: 40px solid rgb(2, 188, 255);
                max-height: 500px; 
            }
            #customUserInput::placeholder {
    color: gray; 
}
            .custom-chat-box {
                max-height: 400px; 
                overflow-y: auto; 
                padding: 0px;
                margin-bottom: 0px;
                margin: 0;
                border: none;
            }
            
            .custom-chat-close {
                color: #000000;
                position: absolute;
                top: -45px;
                right: 10px;
                font-size: 28px;
                font-weight: bold;
                cursor: pointer;
            }
            
            .custom-chat-close:hover,
            .custom-chat-close:focus {
                color: black;
                text-decoration: none;
            }
            
            .custom-chat-box-container {
                border: none;
                margin: 0;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: #ccc transparent;
            }
            
            .custom-chat-message {
                margin-bottom: 10px;
                padding: 10px;
                border-radius: 10px;
                overflow-wrap: break-word;
                color: black;
                clear: both;
            }
            
            .custom-user-message {
                background-color: rgb(2, 188, 255);
                color: rgb(0, 0, 0);
                float: right;
                max-width: 70%;
            }
            
            .custom-bot-message {
                background-color: #ffffff;
                color: rgb(0, 0, 0);
                float: left;
                max-width: 70%;
            }
            
            .custom-chat-input {
                width: calc(100%);
                padding: 10px;
                border: none;
                border-top: none;
                border-radius: 0 0 10px 10px;
                box-sizing: none;
                outline: none;
                font-size: 16px;
                color: black;
            }
            
            .custom-send-button {
                position: absolute;
                top: 94%;
                right: 10px;
                transform: translateY(-50%);
                font-size: 25px;
                cursor: pointer;
                color: rgb(2, 188, 255);
            }
            
            .custom-preguntas-container {
                display: flex;
                flex-direction: column;
            }
            
            .custom-pregunta-btn {
                margin: 5px;
                padding: 10px;
                background-color:  rgb(2, 188, 255);
                color: rgb(0, 0, 0);
                border: none;
                border-radius: 5px;
                cursor: pointer;
            }
            
            .custom-ot {
                color: #ffffff;
                position: absolute;
                top: -45px;
                left: 10px;
                font-size: 28px;
                font-weight: bold;
            }
        </style>
    </head>
    <body>
    
    <div class="custom-chat-container" id="customChatContainer">
        <i class="fas fa-comment-dots" onclick="openCustomChatModal()"></i>
    </div>
    
    <!-- Ventana modal -->
    <div class="custom-chat-modal" id="customChatModal">
        <p class="custom-ot">One To One </p>
        <span class="custom-chat-close" onclick="closeCustomChatModal()">&times;</span>
   
        <div class="custom-chat-box-container">
            <div class="custom-chat-box" id="customChatBox"></div>
        </div>
        <input type="text" id="customUserInput" class="custom-chat-input" placeholder="Escribe un mensaje...">

        <i class="fas fa-paper-plane custom-send-button" onclick="sendCustomMessage()"></i>
    </div>
    
   
    <script>
        const customPreguntasRespuestas = {
           
            '¿Por qué tengo que iniciar sesión?': 'No es necesario iniciar sesión para ver el contenido de nuestra tienda.',
'¿Necesito tener una cuenta para comprar?': 'Sí, en efecto, necesitas tener una cuenta para realizar una compra.',
'¿Cómo puedo crear una cuenta?': 'Para crear una cuenta, dirígete a la parte superior de la página, haz clic en el icono de usuario y luego selecciona "Crear cuenta" o visita este enlace: http://localhost:3000/usuarios/ingreso.',
'¿Puedo realizar compras al por mayor?': 'Sí, para realizar compras al por mayor, deja tu correo electrónico en la parte inferior de la página donde dice "Enviamos tus recomendaciones", y un proveedor de One to One se pondrá en contacto contigo.',
'Quiero eliminar mi cuenta': 'Puedes gestionar la eliminación de tu cuenta iniciando sesión, yendo al perfil de usuario y haciendo clic en el botón que dice "Eliminar cuenta". Una vez hecho esto, tu cuenta se eliminará automáticamente. Saludos.',
        };
    
        const customChatBox = document.getElementById('customChatBox');
        const customUserInput = document.getElementById('customUserInput');
        let customPrimerMensajeEnviado = false;
    
        function openCustomChatModal() {
            document.getElementById('customChatModal').style.display = 'block';
            document.getElementById('customChatContainer').style.display = 'none';
        }
    
        function closeCustomChatModal() {
            document.getElementById('customChatModal').style.display = 'none';
            document.getElementById('customChatContainer').style.display = 'block'; 
        }
    
        function sendCustomMessage() {
            const message = customUserInput.value.trim();
            if (message !== '') {
                appendCustomMessage('user', message);
                customUserInput.value = '';
                respondToCustomMessage(message);
            }
        }
    
        function showCustomQuestionForm() {
            let formHTML = '<div class="custom-preguntas-container">';
            for (const pregunta in customPreguntasRespuestas) {
                formHTML += `<button class="custom-pregunta-btn" onclick="selectCustomQuestion('${pregunta}')">${pregunta}</button>`;
            }
            formHTML += '</div>';
            appendCustomMessage('bot', formHTML);
        }
    
        function selectCustomQuestion(pregunta) {
            appendCustomMessage('user', pregunta);
            respondToCustomMessage(pregunta);
        }
    
        function appendCustomMessage(sender, message) {
            const messageElement = document.createElement('div');
            messageElement.classList.add('custom-chat-message', sender === 'user' ? 'custom-user-message' : 'custom-bot-message');
            messageElement.innerHTML = message;
            customChatBox.appendChild(messageElement);
            customChatBox.scrollTop = customChatBox.scrollHeight;
        }
    
        function respondToCustomMessage(message) {
            setTimeout(() => {
                if (!customPrimerMensajeEnviado) {
                    appendCustomMessage('bot', 'Hola, somos One To One'); 
                    customPrimerMensajeEnviado = true;
                }
                const cleanMessage = message.toLowerCase().replace(/[¿?]/g, '').trim();
                if (customPreguntasRespuestas.hasOwnProperty(cleanMessage)) {
                    appendCustomMessage('bot', customPreguntasRespuestas[cleanMessage]);
                    setTimeout(() => {
                        appendCustomMessage('bot', 'Espero haberte ayudado, si necesitas otra cosa no dudes en consultar');
                        showCustomQuestionForm();
                    }, 1000);
                } else if (message in customPreguntasRespuestas) {
                    appendCustomMessage('bot', customPreguntasRespuestas[message]);
                    setTimeout(() => {
                        appendCustomMessage('bot', 'Espero haberte ayudado, si necesitas otra cosa no dudes en consultar');
                        showCustomQuestionForm();
                    }, 1000);
                } else {
                    appendCustomMessage('bot', 'Soy un bot diseñado para ayudarte en lo que necesites.');
                    showCustomQuestionForm();
                }
            }, 1000);
        }
    
        customUserInput.addEventListener("keyup", function(event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                sendCustomMessage();
            }
        });
    
        window.onload = function() {
            appendCustomMessage('bot', 'Hola, Me llamo  Ian,soy un bot diseñado para resolver tus dudas de forma rapida y automatica, en que puedo ayudarte?  '); // Mensaje inicial al cargar la página
            showCustomQuestionForm();
        };
    </script>
        

