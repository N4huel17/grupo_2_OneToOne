<!DOCTYPE html>
<html lang="es">

    <!-- //HEAD PARTIALS-->
    <%- include('../partials/head',{
        title:'Registro'
    })  %>

<body>
  <!-- //HEADER PARTIALS-->
    
  <%- include('../partials/header') %>

<main class="main_register">  
    <p class="register-parrafo-one"><a href="">Inicio / </a><a href="">Mi cuenta / </a><a href=""><b>Crear cuenta</b></a>  </p>

    <p class="register-parrafo" >Comprá mas rápido y llevá el control de tus pedidos, ¡en un solo lugar!</p>
   
   
    <section class="row">
        <div class="col-12 col-md-10 col-lg-6 mx-auto my-5">
            <div class="register_contenedor">
                <div class="register-header">
                    <h4 class="card-title">Registro de usuario</h4>
                </div>
                <div class="card-body">
                    <form action="" id="form-register" class="row" method="POST">
                      <div class="col-12">
                        <div class=" alerts alerts-danger  " id="msg-error" hidden>
                          Todos los campos son requeridos
                        </div>
                      </div>
                      
                          <div class="col-12 col-md-6 mb-3">
                            <label for="name" class="form-label">Nombre</label>
                            <input type="text" name="name" class="form-control <%= locals.errors && errors.name ? 'is-invalid' : null %>"    id="name"
                            value="<%= locals.old && old.name ? old.name : null %>" 
                             placeholder="ej : Noah Benjamin">
                        
                          <small class="text-danger ms-2" id="error-name">
                            <%= locals.errors && errors.name ? errors.name.msg : null %>
                          </small>
                          </div>


                          <div class="col-12 col-md-6 mb-3">
                            <label for="surname" class="form-label">Apellido</label>
                            <input type="text" name="surname" class="form-control <%= locals.errors && errors.surname ? 'is-invalid' : null %>" id="surname"
                            value="<%= locals.old && old.name ? old.name : null %>"
                             placeholder="ej : Mendez">
                             <small id="error-surname" class="text-danger ms-2">
                              <%= locals.errors && errors.surname ? errors.surname.msg : null %>
                            </small>
                          </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input type="text" name="email" class="form-control <%= locals.errors && errors.email ? 'is-invalid' : null %>" id="email"
                            value="<%= locals.old && old.email ? old.email : null %>"
                             placeholder="***@gmail.com">
                             <small id="error-email" class="text-danger ms-2">
                              <%= locals.errors && errors.email ? errors.email.msg : null %>
                            </small>
                          </div>

                          <div class="col-12 mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <div class="input-group">
                            <input type="password" name="password"  class="form-control <%= locals.errors && errors.password ? 'is-invalid' : null %>" id="password">
                            <span class="input-group-text"><i id="button-eye" class="fa-regular fa-eye"></i></span>
                            </div>
                            <small id="error-password" class="text-danger ms-2">
                              <%= locals.errors && errors.password ? errors.password.msg : null %>
                            </small>
                            </div>

                          <div class="col-12 mb-3">
                            <label for="password2" class="form-label">Confirmar contraseña</label>
                            <div class="input-group">
                            <input type="password" name="password2" class="form-control <%= locals.errors && errors.password2 ? 'is-invalid' : null %>" id="password2">
                            <span class="input-group-text"><i id="button-eye2" class="fa-regular fa-eye"></i></span>
                          </div>
                            <small id="error-password2" class="text-danger ms-2">
                              <%= locals.errors && errors.password2 ? errors.password2.msg : null %>
                            </small>
                          </div>


                          <div class="col-12 col-md-6 mb-3">
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" value="1" id="acceptTerms" name="acceptTerms" />
                              <label class="form-check-label" for="acceptTerms">
                                Acepto los <a href="#" class="link-dark" id="openModalBtn">términos y condiciones</a> </label>
                            </div>
                            <small class="text-danger ms-2">
                              <%= locals.errors && errors.acceptTerms ? errors.acceptTerms.msg : null %>
                            </small>
                          </div>
                          <div class="col-12 col-md-6 mb-3">
                            <button class="btn btn-dark w-100">Registrate</button>
                          </div>
                          <h4 class="register-h4">¿Ya tienes una cuenta? <a href="ingreso"><b>Iniciar Sesion</b></h4></a>
                    </form>
                </div>
            </div>
        </div>
    </section>
     <!-- Modal -->
    
    <div id="modal" class="modal">
      <div class="modal-content">
        <span class="close" id="closeModalBtn">&times;</span>
        <h2>Términos y condiciones</h2>
        <ol>
          <li>
            Utilizamos cookies propias y de terceros durante la navegación por el sitio web, con la finalidad de permitir el acceso a las funcionalidades de la página web, extraer estadísticas de tráfico y mejorar la experiencia del usuario. Puedes aceptar todas las cookies, así como seleccionar cuáles deseas habilitar o configurar sus preferencias. Para más información, puede consultar nuestra Política de cookies.
          </li>
        </ol>
        <button id="acceptBtn">Aceptar</button>
      </div>
    </div>

    <!-- //FOOTER PARTIALS-->
    <%- include('../partials/footer') %>
    <script src="/javascripts/registerValidator.js"></script>
    <script>
      // Función para abrir el modal
      var openModalBtn = document.getElementById("openModalBtn");
      var modal = document.getElementById("modal");
      openModalBtn.addEventListener("click", function() {
        modal.style.display = "block";
      });

      // Función para cerrar el modal
      var closeModalBtn = document.getElementById("closeModalBtn");
      closeModalBtn.addEventListener("click", function() {
        modal.style.display = "none";
      });

      // Función para aceptar los términos y condiciones
      document.getElementById("acceptBtn").addEventListener("click", function() {
        // Agrega aquí el código que se ejecutará cuando el usuario acepte los términos
        alert("Términos y condiciones aceptados");
        modal.style.display = "none"; // Cerrar el modal después de aceptar
      });
    </script>
</body>

</html>